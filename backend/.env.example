# Used when a monitor has no webhook of its own. Keep this secret; it is never sent to the frontend.
DISCORD_WEBHOOK_URL=

# Linked from notifications
PUBLIC_DASHBOARD_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Seeds sample monitors on first start when the database is empty
DEMO_MODE=true

SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
MAX_CONCURRENT_CHECKS=2
PAGE_TIMEOUT_SECONDS=30

# Suppress an identical A->B change that was already notified within this window
NOTIFY_DEDUP_HOURS=24
MAX_HISTORY_PER_MONITOR=100

# Only set to true inside Docker/CI where Chromium cannot use its sandbox
PLAYWRIGHT_NO_SANDBOX=false

USER_AGENT=WatchtowerBot/1.0 (website change monitor)

# Email alerts (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true

# Telegram alerts: create a bot with BotFather, then set a chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional daily digest (digest scheduler endpoint is exposed; schedule with OS task/cron)
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_HOUR=9

# Fetch reliability and polite per-domain limits
FETCH_RETRY_ATTEMPTS=3
DOMAIN_MIN_INTERVAL_SECONDS=1.0
FETCH_CACHE_SECONDS=3.0
